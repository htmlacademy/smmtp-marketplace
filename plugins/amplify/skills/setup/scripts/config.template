# Crossposting settings, read by amplify.py.
# .env.local holds the values, secrets included; .env.example beside it is the
# copy without secrets to share. One NAME=value per line; an empty value is
# unset. The amplify:setup skill fills this file in.

# The service's https root and master token, name:secret, from https://smmtp.ru
# or mail@smmtp.ru.
AMPLIFY_REST_URL=
AMPLIFY_REST_TOKEN=

# The app token that publishes; amplify.py app-token writes it.
AMPLIFY_REST_APP_TOKEN=

# Media gateway for images and videos: both or neither.
AMPLIFY_MEDIA_GATEWAY_URL=
AMPLIFY_MEDIA_GATEWAY_TOKEN=

# Read empty secrets from a store; {name} is the variable's name. macOS keychain:
# AMPLIFY_REST_SECRET_COMMAND=security find-generic-password -s {name} -w

# Certificate bundle to trust after CERTIFICATE_VERIFY_FAILED. macOS:
# SSL_CERT_FILE=/etc/ssl/cert.pem

# One channel per platform; amplify.py connect writes them, for example:
# AMPLIFY_CHANNEL_TELEGRAM=

# Values a platform's connection asks for, such as TELEGRAM_BOT_TOKEN, stay
# here only until it is connected.
